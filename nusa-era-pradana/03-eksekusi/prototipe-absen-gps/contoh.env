# Salin berkas ini menjadi .env lalu ubah nilainya:
#   macOS/Linux : cp contoh.env .env
#   Windows     : copy contoh.env .env
# Semua baris boleh dihapus; server punya nilai bawaan.

# Port dan alamat server. 0.0.0.0 = bisa diakses perangkat lain di jaringan yang sama.
PORT=3000
HOST=0.0.0.0

# Lokasi berkas database. Isi :memory: untuk database yang hilang saat server mati.
# DB_FILE=:memory:

# Kunci halaman /rekap. Kalau kosong, server membuat kunci acak tiap kali dijalankan.
KUNCI_ADMIN=ganti-dengan-kunci-sendiri

# Nilai awal lokasi kantor, hanya dipakai saat database baru dibuat.
# Setelah itu ubah lewat halaman /rekap.
KANTOR_NAMA=Kantor contoh (Lapangan Merdeka, Medan)
KANTOR_LAT=3.5906
KANTOR_LON=98.6779
KANTOR_RADIUS_M=100
BATAS_AKURASI_M=50

# Absen jenis yang sama oleh ID yang sama ditolak kalau jaraknya kurang dari N detik.
JEDA_ABSEN_GANDA_DETIK=60

# Isi 1 kalau server berada di belakang tunnel/reverse proxy (cloudflared, ngrok, nginx),
# supaya IP yang dicatat adalah IP pengguna, bukan IP tunnel.
# TRUST_PROXY=1

# HTTPS langsung dari server (untuk uji HP lewat Wi-Fi). Buat sertifikat dengan mkcert.
# SSL_KEY=./sertifikat/kunci.pem
# SSL_CERT=./sertifikat/sertifikat.pem

# ---------- Notifikasi WhatsApp (opsional) ----------
# Butuh: npm install (memasang whatsapp-web.js dan Chromium, sekitar 200 MB).
# Saat pertama jalan, pindai QR di terminal atau di tab WhatsApp halaman /rekap
# memakai WhatsApp di HP: Setelan, Perangkat tertaut, Tautkan perangkat.
# Pakai nomor WhatsApp khusus/cadangan, bukan nomor pribadi utama.
WA_AKTIF=0

# Nomor admin penerima notifikasi, pisahkan dengan koma. Boleh format 08xx atau 628xx.
# ID grup (akhiran @g.us) juga bisa.
WA_NOMOR_ADMIN=081234567890

# Kapan absen dikirim ke WA: semua | bermasalah (di luar area / akurasi rendah) | mati
# Kode logout selalu dikirim selama WA aktif.
WA_NOTIF_ABSEN=semua

# Folder penyimpan login WhatsApp. Hapus folder ini untuk login ulang dengan QR baru.
# WA_FOLDER_SESI=./data/wa-sesi

# Pakai Chrome yang sudah terpasang kalau Chromium bawaan puppeteer bermasalah.
# WA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
