{
  "name": "prototipe-absen-gps",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipe absen berbasis GPS browser: Geolocation API, Node.js, dan SQLite bawaan Node. Tanpa dependensi npm.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  }
}
